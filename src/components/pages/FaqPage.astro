---
// Plantilla única de /faq para ES y EN. Textos y JSON-LD: src/i18n/faq.mjs · Precios y plazos: src/data/oferta.mjs
import { faq } from '../../i18n/faq.mjs';
import { fill, fillDeep } from '../../data/oferta.mjs';
const { lang = 'es' } = Astro.props;
const t = (k) => fill(faq[lang].k[k], lang);
const p = (path) => (lang === 'en' ? '/en' + path : path);
const schema = fillDeep(faq[lang].jsonld, lang);
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<style is:global>
/* PAGE HERO */
.pg-faq .faq-hero { padding: 140px 0 72px; background: var(--night-2); border-bottom: 1px solid var(--border); }
.pg-faq .faq-hero .page-tag { font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--green); margin-bottom: 16px; }
.pg-faq .faq-hero h1 { font-family: 'Syne', sans-serif; font-weight: 800; font-size: clamp(32px, 5vw, 52px); letter-spacing: -.03em; line-height: 1.05; margin-bottom: 16px; }
.pg-faq .faq-hero h1 em { color: var(--green); font-style: normal; }
.pg-faq .faq-hero p { font-size: 18px; font-weight: 300; color: rgba(238,241,246,0.6); max-width: 560px; line-height: 1.65; }

/* ESPEJO */
.pg-faq #espejo { background: var(--night); padding: 96px 0; }
.pg-faq .espejo-intro { font-family: 'Syne', sans-serif; font-weight: 800; font-size: clamp(20px, 3vw, 28px); letter-spacing: -.02em; line-height: 1.2; max-width: 640px; margin-bottom: 48px; }
.pg-faq .espejo-intro span { color: var(--green); }
.pg-faq .espejo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 48px; }
.pg-faq .espejo-q { background: var(--night-3); border: 1px solid var(--border); border-radius: 12px; padding: 24px 24px 24px 20px; border-left: 3px solid rgba(0,232,145,0.3); transition: border-color .2s, border-left-color .2s; }
.pg-faq .espejo-q:hover { border-color: rgba(0,232,145,0.25); border-left-color: var(--green); }
.pg-faq .espejo-q p { font-family: 'Syne', sans-serif; font-weight: 700; font-size: clamp(14px, 1.6vw, 16px); line-height: 1.35; color: rgba(238,241,246,0.85); }
.pg-faq .espejo-cta-strip { display: flex; align-items: center; gap: 20px; padding: 24px 28px; background: rgba(0,232,145,0.04); border: 1px solid rgba(0,232,145,0.15); border-radius: 12px; flex-wrap: wrap; }
.pg-faq .espejo-cta-txt { font-family: 'Syne', sans-serif; font-weight: 800; font-size: clamp(15px, 2vw, 18px); flex: 1; min-width: 220px; }
.pg-faq .espejo-cta-txt span { color: var(--green); }

/* FAQ SECTIONS */
.pg-faq #faq-page { background: var(--night-2); padding: 96px 0; }
.pg-faq .faq-cats { display: flex; flex-direction: column; gap: 64px; }
.pg-faq .faq-cat-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: clamp(18px, 2.5vw, 24px); letter-spacing: -.02em; margin-bottom: 4px; }
.pg-faq .faq-cat-sub { font-size: 14px; color: var(--muted); margin-bottom: 24px; }
.pg-faq .faq-list { display: flex; flex-direction: column; gap: 2px; }
.pg-faq .faq-item { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; transition: border-color .2s; }
.pg-faq .faq-item.open { border-color: rgba(0,232,145,.25); }
.pg-faq .faq-q-btn { width: 100%; background: var(--night-3); border: none; text-align: left; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; font-family: 'Syne', sans-serif; font-weight: 800; font-size: clamp(14px, 1.8vw, 16px); color: var(--offwh); letter-spacing: -.01em; line-height: 1.3; transition: background .15s; }
.pg-faq .faq-q-btn:hover { background: rgba(255,255,255,.03); }
.pg-faq .faq-ico { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; border: 1px solid rgba(0,232,145,.3); display: flex; align-items: center; justify-content: center; color: var(--green); transition: transform .25s; font-size: 16px; line-height: 1; }
.pg-faq .faq-item.open .faq-ico { transform: rotate(45deg); }
.pg-faq .faq-ans { max-height: 0; overflow: hidden; transition: max-height .32s ease; }
.pg-faq .faq-item.open .faq-ans { max-height: 400px; }
.pg-faq .faq-ans-inner { padding: 0 24px 22px; font-size: 15px; color: rgba(238,241,246,0.7); line-height: 1.75; }
.pg-faq .faq-ans-inner strong { color: var(--green); font-weight: 600; }
.pg-faq .faq-ans-inner a { color: var(--green); text-decoration: underline; text-underline-offset: 3px; }

/* CTA FINAL */
.pg-faq .faq-cta-band { background: var(--night); border-top: 1px solid var(--border); padding: 80px 0; text-align: center; }
.pg-faq .faq-cta-band h2 { font-family: 'Syne', sans-serif; font-weight: 800; font-size: clamp(24px, 4vw, 40px); letter-spacing: -.03em; margin-bottom: 12px; }
.pg-faq .faq-cta-band h2 span { color: var(--green); }
.pg-faq .faq-cta-band p { font-size: 16px; color: var(--muted); margin-bottom: 32px; max-width: 480px; margin-left: auto; margin-right: auto; }
.pg-faq .cta-buttons { display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; }

@media (max-width: 700px) {
  .pg-faq .espejo-grid { grid-template-columns: 1fr; }
  .pg-faq .espejo-cta-strip { flex-direction: column; text-align: center; }
  .pg-faq .espejo-cta-strip .btn { width: 100%; justify-content: center; }
}
</style>
