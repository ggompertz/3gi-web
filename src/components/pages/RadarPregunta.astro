---
import RadarCampo from './RadarCampo.astro';
// Una pregunta completa: título, ayuda, aviso de precarga, controles, «No sé» y su propio mensaje de error.
const { id, def, dic, t } = Astro.props;
const legendId = `rp-t-${id}`;
const condicion = def.visible_si ? JSON.stringify(def.visible_si) : undefined;
const camposDe = (d) => Object.entries(d.campos ?? {});
// Acompañante de «Otro» / «¿Quién?»: pregunta de texto que solo aparece cuando su padre la pide (condición positiva `eq` o `incluye`).
const esAcomp = ['eq', 'incluye'].includes(def.visible_si?.op);
const ayudaId = `rp-a-${id}`;
---
<div class={esAcomp ? 'rp-pregunta rp-acomp' : 'rp-pregunta'} data-pregunta={id} data-tipo={def.tipo} data-visible-si={condicion} data-acomp={esAcomp ? '1' : undefined} data-obligatoria={def.obligatoria ? '1' : undefined}>
  <fieldset class="rp-fieldset">
    <legend class="rp-titulo" id={legendId}>{dic.titulo}{def.obligatoria && <span class="rp-oblig">{t.ui.obligatoria}</span>}</legend>
    {dic.ayuda && !esAcomp && <p class="rp-ayuda">{dic.ayuda}</p>}
    {esAcomp && <p class="rp-ayuda" id={ayudaId}>{dic.ayuda ? `${dic.ayuda} ` : ''}{t.ui.otro_advertencia}</p>}

    {def.precarga && (
      <div class="rp-precarga" data-precarga hidden>
        <p class="rp-precarga-t">{t.ui.precarga_titulo}</p>
        <blockquote class="rp-precarga-texto" data-precarga-texto></blockquote>
        <p class="rp-ayuda">{t.ui.precarga_nota}</p>
        <button type="button" class="rp-btn rp-btn-sec" data-usar-precarga hidden>{t.ui.precarga_usar}</button>
      </div>
    )}

    <div class="rp-controles" data-controles>
      {def.tipo === 'compuesto' && camposDe(def).map(([k, c]) => <RadarCampo path={`${id}.${k}`} def={c} dic={dic.campos[k]} t={t} />)}

      {def.tipo === 'repetidor' && (
        <div class="rp-repetidor" data-repetidor data-max={def.max}>
          <template data-fila>
            <div class="rp-fila" data-fila-activa>
              <p class="rp-fila-t" data-fila-titulo></p>
              {camposDe(def).map(([k, c]) => <RadarCampo path={`${id}[#].${k}`} def={c} dic={dic.campos[k]} t={t} />)}
              <button type="button" class="rp-btn rp-btn-sec rp-btn-chico" data-quitar-fila>{t.ui.quitar}</button>
            </div>
          </template>
          <div data-filas></div>
          <button type="button" class="rp-btn rp-btn-sec" data-agregar-fila>{t.ui.agregar_tarea}</button>
        </div>
      )}

      {def.tipo === 'ref_repetidor' && (
        <div class="rp-campo">
          <select class="rp-input" data-campo={id} data-ref={def.ref} aria-labelledby={legendId}>
            <option value="">{t.ui.elegir}</option>
          </select>
          <p class="rp-ayuda" data-ref-aviso hidden>{t.ui.ref_sin_tareas}</p>
        </div>
      )}

      {!['compuesto', 'repetidor', 'ref_repetidor'].includes(def.tipo) && <RadarCampo path={id} def={def} dic={dic} labelledby={legendId} t={t} describedby={esAcomp ? ayudaId : undefined} />}
    </div>

    {!esAcomp && <label class="rp-nose"><input type="checkbox" data-nose={id} /><span>{t.ui.no_se}</span></label>}
    {!esAcomp && <p class="rp-aviso" role="status" data-nose-aviso hidden>{t.ui.nose_descarta}</p>}
    <p class="rp-error" role="alert" data-error hidden></p>
  </fieldset>
</div>
