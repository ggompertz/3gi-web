<style is:global>
.pg-nos *,.pg-nos *:before,.pg-nos *:after{box-sizing:border-box;margin:0;padding:0}.pg-nos html{scroll-behavior:smooth}.pg-nos body{background:#06060d;color:#eef1f6;font-family:DM Sans,sans-serif;font-weight:400;line-height:1.6;-webkit-font-smoothing:antialiased}.pg-nos a{text-decoration:none;color:inherit}:root{--green: #00E891;--grn-dk: #009E60;--night: #06060D;--night-2: #0D0D1A;--night-3: #141422;--offwh: #EEF1F6;--muted: rgba(238,241,246,.45);--border: rgba(255,255,255,.07);--max: 1160px}.pg-nos .container{max-width:var(--max);margin:0 auto;padding:0 24px}.pg-nos .logo{display:inline-flex;flex-direction:column;font-family:Syne,sans-serif;font-weight:800;line-height:1}.pg-nos .logo-name{font-size:22px;letter-spacing:-.03em}.pg-nos .logo-name span{color:var(--green)}.pg-nos .logo-sub{font-size:7.5px;letter-spacing:.2em;text-transform:uppercase;color:#eef1f64d;margin-top:4px}.pg-nos .btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:8px;border:none;font-family:DM Sans,sans-serif;font-weight:500;font-size:15px;cursor:pointer;transition:all .2s;white-space:nowrap}.pg-nos .btn-primary{background:linear-gradient(90deg,#2563EB,#00E891);color:var(--night)}.pg-nos .btn-primary:hover{background:linear-gradient(90deg,#1D4ED8,#00ffA0);transform:translateY(-1px)}.pg-nos .btn-outline{background:transparent;color:var(--offwh);border:1px solid rgba(238,241,246,.2)}.pg-nos .btn-outline:hover{border-color:var(--green);color:var(--green)}.pg-nos nav{position:fixed;top:0;left:0;right:0;z-index:100;background:#06060de6;backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}.pg-nos .nav-inner{max-width:var(--max);margin:0 auto;padding:0 24px;height:68px;display:flex;align-items:center;justify-content:space-between}.pg-nos .nav-links{display:flex;align-items:center;gap:32px;list-style:none}.pg-nos .nav-links a{font-size:14px;color:var(--muted);transition:color .2s}.pg-nos .nav-links a:hover,.pg-nos .nav-links a.active{color:var(--offwh)}.pg-nos .nav-cta{display:flex;gap:10px;align-items:center}.pg-nos .page-hero{padding:140px 0 72px;background:var(--night-2);border-bottom:1px solid var(--border)}.pg-nos .page-tag{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin-bottom:16px}.pg-nos .page-title{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(32px,5vw,56px);letter-spacing:-.03em;line-height:1.05;margin-bottom:16px}.pg-nos .page-sub{font-size:18px;font-weight:300;color:#eef1f699;max-width:600px;line-height:1.65}.pg-nos .founder-section{padding:80px 0}.pg-nos .founder-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}.pg-nos .founder-bio h2{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(28px,3vw,40px);letter-spacing:-.02em;margin-bottom:24px;line-height:1.15}.pg-nos .founder-bio p{font-size:16px;font-weight:300;color:#eef1f6bf;line-height:1.8;margin-bottom:20px}.pg-nos .founder-bio p strong{color:var(--offwh);font-weight:500}.pg-nos .founder-card{background:var(--night-3);border:1px solid var(--border);border-radius:16px;padding:36px}.pg-nos .founder-avatar{width:88px;height:88px;border-radius:50%;display:block;margin-bottom:20px;border:2px solid rgba(0,232,145,0.25)}.pg-nos .founder-name{font-family:Syne,sans-serif;font-weight:800;font-size:22px;letter-spacing:-.02em;margin-bottom:4px}.pg-nos .founder-title{font-size:14px;color:var(--muted);margin-bottom:24px}.pg-nos .founder-social{display:flex;flex-direction:column;gap:10px}.pg-nos .social-link{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--muted);transition:color .2s;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.04)}.pg-nos .social-link:last-child{border-bottom:none}.pg-nos .social-link:hover{color:var(--offwh)}.pg-nos .social-icon{width:32px;height:32px;border-radius:6px;background:#ffffff0d;display:flex;align-items:center;justify-content:center;flex-shrink:0}.pg-nos .stats-section{padding:80px 0;background:var(--night-2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.pg-nos .stats-title{font-family:Syne,sans-serif;font-weight:800;font-size:32px;letter-spacing:-.02em;margin-bottom:8px}.pg-nos .stats-sub{font-size:16px;color:var(--muted);margin-bottom:24px}.pg-nos .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.pg-nos .stat-card{background:var(--night-3);border:1px solid var(--border);border-radius:12px;padding:28px 24px}.pg-nos .stat-number{font-family:Syne,sans-serif;font-weight:800;font-size:40px;letter-spacing:-.03em;color:var(--green);line-height:1;margin-bottom:8px}.pg-nos .stat-label{font-size:14px;font-weight:400;color:#eef1f699;line-height:1.4}.pg-nos .origin-section{padding:80px 0}.pg-nos .origin-inner{max-width:760px}.pg-nos .origin-inner h2{font-family:Syne,sans-serif;font-weight:800;font-size:32px;letter-spacing:-.02em;margin-bottom:32px}.pg-nos .origin-inner p{font-size:16px;font-weight:300;color:#eef1f6bf;line-height:1.8;margin-bottom:20px}.pg-nos .origin-inner p strong{color:var(--offwh);font-weight:500}.pg-nos .origin-quote{padding:28px 32px;border-left:3px solid var(--green);background:#00e8910a;border-radius:0 10px 10px 0;margin:36px 0}.pg-nos .origin-quote p{font-size:18px;font-style:italic;font-weight:300;color:#eef1f6d9;line-height:1.7;margin:0}.pg-nos .values-section{padding:80px 0;background:var(--night-2);border-top:1px solid var(--border)}.pg-nos .values-title{font-family:Syne,sans-serif;font-weight:800;font-size:32px;letter-spacing:-.02em;margin-bottom:8px}.pg-nos .values-sub{font-size:16px;color:var(--muted);margin-bottom:24px}.pg-nos .values-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.pg-nos .value-card{background:var(--night-3);border:1px solid var(--border);border-radius:12px;padding:28px 24px}.pg-nos .value-icon{font-size:28px;margin-bottom:16px}.pg-nos .value-title{font-family:Syne,sans-serif;font-weight:700;font-size:18px;letter-spacing:-.01em;margin-bottom:10px}.pg-nos .value-desc{font-size:14px;font-weight:300;color:#eef1f699;line-height:1.7}.pg-nos .cta-section{padding:80px 0;border-top:1px solid var(--border)}.pg-nos .cta-box{max-width:640px}.pg-nos .cta-title{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(28px,4vw,44px);letter-spacing:-.03em;line-height:1.1;margin-bottom:20px}.pg-nos .cta-sub{font-size:17px;font-weight:300;color:#eef1f6a6;margin-bottom:32px;line-height:1.65}.pg-nos .cta-actions{display:flex;gap:12px;flex-wrap:wrap}.pg-nos footer{padding:40px 0;border-top:1px solid var(--border)}.pg-nos .footer-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}.pg-nos .footer-links{display:flex;gap:24px;flex-wrap:wrap}.pg-nos .footer-links a{font-size:13px;color:var(--muted);transition:color .2s}.pg-nos .footer-links a:hover{color:var(--offwh)}.pg-nos .footer-copy{font-size:12px;color:#eef1f640}@media(max-width:768px){.pg-nos .nav-links{display:none}.pg-nos .founder-grid{grid-template-columns:1fr;gap:40px}.pg-nos .stats-grid{grid-template-columns:repeat(2,1fr)}.pg-nos .values-grid{grid-template-columns:1fr}.pg-nos .cta-actions{flex-direction:column}}@media(max-width:480px){.pg-nos .stats-grid{grid-template-columns:1fr}}


.pg-nos .founder-education{margin-top:28px;padding-top:24px;border-top:1px solid var(--border)}.pg-nos .founder-education>h3{font-family:Syne,sans-serif;font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--green);margin-bottom:16px}.pg-nos .edu-groups{display:flex;flex-direction:column;gap:14px}.pg-nos .edu-group{background:rgba(0,232,145,.04);border:1px solid rgba(0,232,145,.12);border-radius:10px;padding:14px 16px}.pg-nos .edu-group-label{font-family:Syne,sans-serif;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--green);opacity:.7;margin-bottom:10px}.pg-nos .edu-group ul{list-style:none;display:flex;flex-direction:column;gap:6px}.pg-nos .edu-group li{font-size:13px;font-weight:300;color:#eef1f6bf;padding-left:12px;position:relative;line-height:1.5}.pg-nos .edu-group li::before{content:"·";position:absolute;left:0;color:var(--green)}.pg-nos .edu-group li strong{color:#eef1f6;font-weight:500}.pg-nos .edu-certs{margin-top:8px;border-top:1px solid rgba(255,255,255,.06);padding-top:8px;display:flex;flex-direction:column;gap:4px}.pg-nos .edu-cert{font-size:12px;color:rgba(238,241,246,.45);padding-left:12px;position:relative;line-height:1.5}.pg-nos .edu-cert::before{content:"–";position:absolute;left:0;color:rgba(0,232,145,.35)}
/* Diferencias de diseño propias de la versión en inglés (así estaban en la página original). */.pg-nos[data-lang="en"] .founder-avatar{background:linear-gradient(135deg,var(--grn-dk),var(--green));display:flex;align-items:center;justify-content:center;font-family:Syne,sans-serif;font-weight:800;font-size:32px;color:var(--night);border:unset}.pg-nos[data-lang="en"] .stats-sub{margin-bottom:48px}.pg-nos[data-lang="en"] .values-sub{margin-bottom:48px}</style>
