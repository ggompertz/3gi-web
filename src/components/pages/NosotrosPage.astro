---
// Plantilla única de /nosotros para ES y EN. Textos: src/i18n/nosotros.mjs
// Diferencias de estructura entre idiomas (heredadas de las dos páginas originales): lang === 'es'/'en'.
import { nosotros } from '../../i18n/nosotros.mjs';
const { lang = 'es' } = Astro.props;
const t = (k) => nosotros[lang].k[k];
const p = (path) => (lang === 'en' ? '/en' + path : path);
