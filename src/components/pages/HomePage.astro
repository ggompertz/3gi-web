---
// Plantilla única de la home para ES y EN. Textos: src/i18n/home.mjs · Precios y plazos: src/data/oferta.mjs
// Diferencias de estructura entre idiomas (heredadas de las dos páginas originales) con lang === 'es' / 'en' y <OptDiv>.
import OptDiv from '../OptDiv.astro';
import { home } from '../../i18n/home.mjs';
import { fill } from '../../data/oferta.mjs';
const { lang = 'es' } = Astro.props;
const t = (k) => fill(home[lang].k[k], lang);
const p = (path) => (lang === 'en' ? '/en' + path : path);
---
<style is:global>
  .pg-home .book-strip { background: var(--night-3); border-bottom: 1px solid var(--border); padding: 10px 0; }
  .pg-home .book-strip-inner { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; text-align: center; }
  .pg-home .book-strip a { font-size: 13px; color: rgba(238,241,246,0.75); }
  .pg-home .book-strip a:hover { color: var(--offwh); }
  .pg-home .book-strip strong { color: var(--green); font-weight: 600; }
  .pg-home .book-strip-link { text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  @media (max-width: 600px) {
    .pg-home .book-strip { padding: 8px 0; }
    .pg-home .book-strip a { font-size: 12px; }
  }
</style>
<div class="pg-home" data-lang={lang} style="display:contents">
<div class="book-strip" style="margin-top: 68px;">
    <div class="container book-strip-inner">
      <a href={p('/inteligencia-organizacional')} class="book-strip-link"><Fragment set:html={t('x-001')} /> <strong><Fragment set:html={t('x-002')} /></strong><Fragment set:html={t('x-003')} /></a>
    </div>
  </div>
  <!-- HERO -->
<section id="hero" style={lang === 'es' ? 'padding: 60px 0 72px;' : undefined}>
