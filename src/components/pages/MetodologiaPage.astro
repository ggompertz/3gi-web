---
// Plantilla única de /metodologia para ES y EN. Textos: src/i18n/metodologia.mjs · Precios y plazos: src/data/oferta.mjs
import { metodologia } from '../../i18n/metodologia.mjs';
import { OFERTA, usd, usdRango, radarExpressRango, fill } from '../../data/oferta.mjs';
const { lang = 'es' } = Astro.props;
const t = (k) => fill(metodologia[lang].k[k], lang);
const p = (path) => (lang === 'en' ? '/en' + path : path);
