---
// Plantilla única de /precios para ES y EN. Textos: src/i18n/precios.mjs · Precios: src/data/oferta.mjs
import { precios } from '../../i18n/precios.mjs';
import { OFERTA, usd, usdRango, fill } from '../../data/oferta.mjs';
const { lang = 'es' } = Astro.props;
const t = (k) => fill(precios[lang].k[k], lang);
const p = (path) => (lang === 'en' ? '/en' + path : path);
---
<style>
.page-hero{padding:140px 0 72px;background:var(--night-2);border-bottom:1px solid var(--border)}.page-tag{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin-bottom:16px}.page-title{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(32px,5vw,56px);letter-spacing:-.03em;line-height:1.05;margin-bottom:16px}.page-sub{font-size:18px;font-weight:300;color:#eef1f699;max-width:600px;line-height:1.65}.inv-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px}.inv-card{border-radius:14px;padding:36px 36px 40px;border:1px solid var(--border);position:relative;overflow:hidden;background:var(--night-2)}.inv-card.featured{border-color:rgba(0,232,145,0.35);background:rgba(0,232,145,0.05)}.inv-card.featured:before{content:attr(data-popular);position:absolute;top:0;right:28px;background:var(--green);color:var(--night);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 14px;border-radius:0 0 8px 8px}.inv-name{font-family:Syne,sans-serif;font-weight:800;font-size:22px;letter-spacing:-.02em;margin-bottom:8px}.inv-desc{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:24px}.inv-price{font-family:Syne,sans-serif;font-weight:800;font-size:40px;letter-spacing:-.03em;color:var(--green);margin-bottom:6px;line-height:1}.inv-price-sub{font-size:13px;color:var(--muted);margin-bottom:28px}.inv-includes{list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:32px}.inv-includes li{font-size:14px;color:#eef1f6bf;display:flex;align-items:flex-start;gap:10px}.inv-includes li:before{content:"\2713";color:var(--green);font-weight:700;font-size:13px;margin-top:2px;flex-shrink:0}.inv-note{padding:20px 24px;background:#f59e0b12;border:1px solid rgba(0,232,145,.15);border-radius:10px;margin-top:8px}.inv-note p{font-size:14px;color:#eef1f6b3;line-height:1.65}.inv-note strong{color:var(--green)}#data-foundation{background:var(--night-2)}.df-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}.df-card{background:var(--night-3);border:1px solid var(--border);border-radius:12px;padding:28px 24px}.df-level{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--green);margin-bottom:10px}.df-name{font-family:Syne,sans-serif;font-weight:800;font-size:18px;margin-bottom:8px}.df-price{font-family:Syne,sans-serif;font-weight:800;font-size:22px;color:var(--green);margin-bottom:12px}.df-desc{font-size:13px;color:var(--muted);line-height:1.65}.retainer-card{border:1px solid rgba(0,232,145,.2);border-radius:14px;padding:36px 40px;background:rgba(0,232,145,0.05);display:flex;align-items:center;gap:40px;flex-wrap:wrap;margin-top:20px}.retainer-price{font-family:Syne,sans-serif;font-weight:800;font-size:36px;color:var(--green);white-space:nowrap}.retainer-price span{font-size:16px;color:var(--muted);font-family:DM Sans,sans-serif;font-weight:400}.retainer-desc{flex:1}.retainer-desc h3{font-family:Syne,sans-serif;font-weight:800;font-size:20px;margin-bottom:8px}.retainer-desc p{font-size:14px;color:var(--muted);line-height:1.65}.cta-band{background:var(--night-2);border-top:1px solid var(--border);padding:72px 0;text-align:center}.cta-band h2{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(24px,4vw,40px);letter-spacing:-.03em;margin-bottom:12px}.cta-band p{font-size:16px;color:var(--muted);margin-bottom:32px}.cta-buttons{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}
/* Radar Express — tabla segmentada por tamaño */
.radar-table{width:100%;border-collapse:collapse;margin-top:4px;margin-bottom:20px;font-size:13px}.radar-table th{text-align:left;font-family:Syne,sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:0 10px 8px 0;border-bottom:1px solid var(--border)}.radar-table td{padding:10px 10px 10px 0;border-bottom:1px solid var(--border);color:#eef1f6bf}.radar-table tr:last-child td{border-bottom:none}.radar-table .seg-name{font-weight:700;color:var(--offwh)}.radar-table .seg-price{color:var(--green);font-weight:700;white-space:nowrap}.radar-note{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:24px}
/* Plan de Vuelo */
.pdv-why{margin-top:16px;padding-top:16px;border-top:1px dashed var(--border)}.pdv-why-label{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}.pdv-why p{font-size:13px;color:var(--muted);line-height:1.6;margin:0 0 10px}.pdv-why p:last-child{margin-bottom:0}
/* Data Foundation — certificado DRC-DF */
.cert-callout{background:rgba(0,232,145,.06);border:1px solid rgba(0,232,145,.2);border-radius:12px;padding:24px 28px;margin-top:24px}.cert-callout-title{font-family:Syne,sans-serif;font-weight:800;font-size:15px;color:var(--green);margin-bottom:8px;display:flex;align-items:center;gap:8px}.cert-callout p{font-size:13.5px;color:#eef1f6bf;line-height:1.65;margin:0}.cert-callout code{font-size:12px;background:var(--night-3);padding:2px 6px;border-radius:4px}
/* Piloto Automático — 3 niveles */
.piloto-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}.piloto-card{background:var(--night-3);border:1px solid var(--border);border-radius:12px;padding:28px 24px}.piloto-name{font-family:Syne,sans-serif;font-weight:800;font-size:18px;margin-bottom:6px}.piloto-hours{font-size:12px;color:var(--muted);margin-bottom:14px}.piloto-price{font-family:Syne,sans-serif;font-weight:800;font-size:22px;color:var(--green)}
@media(max-width:900px){.inv-grid,.df-grid,.piloto-grid{grid-template-columns:1fr}.retainer-card{flex-direction:column;gap:20px}}@media(max-width:480px){.inv-price{font-size:clamp(22px,6vw,32px)}.retainer-price{font-size:clamp(18px,5vw,28px);white-space:normal}}
</style>
<div class="page-hero"><div class="container"><div class="page-tag"><Fragment set:html={t('prec-tag')} /></div><h1 class="page-title"><Fragment set:html={t('prec-title')} /></h1><p class="page-sub"><Fragment set:html={t('prec-sub')} /></p></div></div>

<div style="background:rgba(0,232,145,0.06); border-bottom:1px solid rgba(0,232,145,0.15); padding:14px 0;">
  <div class="container" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <p style="font-size:14px; color:rgba(238,241,246,0.85); margin:0;"><Fragment set:html={t('prec-hint-p')} /></p>
    <a href={p('/test-era')} class="btn btn-primary" style="white-space:nowrap; padding:10px 20px; font-size:13px;"><Fragment set:html={t('prec-hint-btn')} /></a>
  </div>
</div>

<section><div class="container"><div class="section-tag"><Fragment set:html={t('prec-diag-tag')} /></div><h2 class="section-title"><Fragment set:html={t('prec-diag-title')} /></h2><p class="section-sub"><Fragment set:html={t('prec-diag-sub')} /></p><div class="inv-grid">
<!-- RADAR EXPRESS -->
<div class="inv-card">
  <div class="inv-name"><Fragment set:html={t('prec-scan-name')} /></div>
  <div class="inv-desc"><Fragment set:html={t('prec-scan-desc')} /></div>
  <table class="radar-table">
    <thead><tr><th><Fragment set:html={t('prec-scan-th-seg')} /></th><th><Fragment set:html={t('prec-scan-th-info')} /></th><th><Fragment set:html={t('prec-scan-th-price')} /></th></tr></thead>
    <tbody>
      <tr><td class="seg-name"><Fragment set:html={t('prec-scan-seg1-name')} /></td><td><Fragment set:html={t('prec-scan-seg1-info')} /></td><td class="seg-price">{usdRango(OFERTA.radar.express.tramos[0].usd, lang)}</td></tr>
      <tr><td class="seg-name"><Fragment set:html={t('prec-scan-seg2-name')} /></td><td><Fragment set:html={t('prec-scan-seg2-info')} /></td><td class="seg-price">{usdRango(OFERTA.radar.express.tramos[1].usd, lang)}</td></tr>
      <tr><td class="seg-name"><Fragment set:html={t('prec-scan-seg3-name')} /></td><td><Fragment set:html={t('prec-scan-seg3-info')} /></td><td class="seg-price">{usdRango(OFERTA.radar.express.tramos[2].usd, lang)}</td></tr>
      <tr><td class="seg-name"><Fragment set:html={t('prec-scan-seg4-name')} /></td><td><Fragment set:html={t('prec-scan-seg4-info')} /></td><td class="seg-price"><Fragment set:html={t('prec-scan-seg4-price')} /></td></tr>
    </tbody>
  </table>
  <p class="radar-note"><Fragment set:html={t('prec-scan-note')} /></p>
  <ul class="inv-includes"><li><Fragment set:html={t('prec-scan-li2')} /></li><li><Fragment set:html={t('prec-scan-li3')} /></li><li><Fragment set:html={t('prec-scan-li4')} /></li><li><Fragment set:html={t('prec-scan-li5')} /></li><li><Fragment set:html={t('prec-scan-li6')} /></li></ul>
  <button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-outline" style="width:100%; justify-content:center;"><span><Fragment set:html={t('prec-scan-btn')} /></span></button>
</div>
<!-- RADAR 360 -->
<div class="inv-card featured" id="radar-360-card" data-popular={lang === 'en' ? 'Most popular' : 'Más popular'}>
  <div class="inv-name"><Fragment set:html={t('prec-full-name')} /></div>
  <div class="inv-desc"><Fragment set:html={t('prec-full-desc')} /></div>
  <div class="inv-price">{usd(OFERTA.radar.r360.usd, lang)}</div>
  <div class="inv-price-sub"><Fragment set:html={t('prec-full-priceSub')} /></div>
  <ul class="inv-includes"><li><Fragment set:html={t('prec-full-li1')} /></li><li><Fragment set:html={t('prec-full-li2')} /></li><li><Fragment set:html={t('prec-full-li3')} /></li><li><Fragment set:html={t('prec-full-li4')} /></li><li><Fragment set:html={t('prec-full-li5')} /></li></ul>
  <button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-primary" style="width:100%; justify-content:center;"><span><Fragment set:html={t('prec-full-btn')} /></span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></button>
</div>
</div><div class="inv-note" style="max-width:760px; margin:0 auto;"><p><Fragment set:html={t('prec-note')} /></p></div></div></section>

<section><div class="container"><div class="section-tag"><Fragment set:html={t('prec-pdv-tag')} /></div><h2 class="section-title"><Fragment set:html={t('prec-pdv-title')} /></h2><p class="section-sub"><Fragment set:html={t('prec-pdv-sub')} /></p>
<div class="inv-card featured" data-popular={lang === 'en' ? 'Quote after your Radar' : 'Cotización tras tu Radar'} style="max-width:640px; margin:0 auto;">
  <div class="inv-desc" style="margin-bottom:20px;"><Fragment set:html={t('prec-pdv-desc')} /></div>
  <ul class="inv-includes"><li><Fragment set:html={t('prec-pdv-li1')} /></li><li><Fragment set:html={t('prec-pdv-li2')} /></li><li><Fragment set:html={t('prec-pdv-li3')} /></li><li><Fragment set:html={t('prec-pdv-li4')} /></li></ul>
  <div class="inv-price">{t('prec-from')} {usd(OFERTA.planDeVuelo.propuesta.desdeUSD, lang)}</div>
  <div class="inv-price-sub"><Fragment set:html={t('prec-pdv-priceSub')} /></div>
  <div class="pdv-why">
    <div class="pdv-why-label"><Fragment set:html={t('prec-pdv-why-label')} /></div>
    <p><Fragment set:html={t('prec-pdv-why-1')} /></p>
    <p><Fragment set:html={t('prec-pdv-why-2')} /></p>
  </div>
  <button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-primary" style="width:100%; justify-content:center; margin-top:24px;"><span><Fragment set:html={t('prec-pdv-btn')} /></span></button>
</div>
</div></section>

<section id="data-foundation"><div class="container"><div class="section-tag"><Fragment set:html={t('prec-df-tag')} /></div><h2 class="section-title"><Fragment set:html={t('prec-df-title')} /></h2><p class="section-sub"><Fragment set:html={t('prec-df-sub')} /></p><div class="df-grid"><div class="df-card"><div class="df-level">{t('prec-level')} N1</div><div class="df-name"><Fragment set:html={t('prec-df1-name')} /></div><div class="df-price">{usdRango(OFERTA.dataFoundation.niveles[0].usd, lang)}</div><div class="df-desc"><Fragment set:html={t('prec-df1-desc')} /></div></div><div class="df-card"><div class="df-level">{t('prec-level')} N2</div><div class="df-name"><Fragment set:html={t('prec-df2-name')} /></div><div class="df-price">{usdRango(OFERTA.dataFoundation.niveles[1].usd, lang)}</div><div class="df-desc"><Fragment set:html={t('prec-df2-desc')} /></div></div><div class="df-card"><div class="df-level">{t('prec-level')} N3</div><div class="df-name"><Fragment set:html={t('prec-df3-name')} /></div><div class="df-price">{usdRango(OFERTA.dataFoundation.niveles[2].usd, lang)}</div><div class="df-desc"><Fragment set:html={t('prec-df3-desc')} /></div></div></div>
<div class="cert-callout"><div class="cert-callout-title">🏅 <span><Fragment set:html={t('prec-cert-title')} /></span></div><p><Fragment set:html={t('prec-cert-desc')} /></p></div>
</div></section>

<section><div class="container"><div class="section-tag"><Fragment set:html={t('prec-ret-tag')} /></div><h2 class="section-title"><Fragment set:html={t('prec-ret-title')} /></h2><p class="section-sub"><Fragment set:html={t('prec-ret-sub')} /></p><div class="piloto-grid">
<div class="piloto-card"><div class="piloto-name"><Fragment set:html={t('prec-ret-basico-name')} /></div><div class="piloto-hours"><Fragment set:html={t('prec-ret-basico-hours')} /></div><div class="piloto-price">{usdRango(OFERTA.piloto[0].usd, lang)}<span style="font-size:13px;color:var(--muted);font-family:'DM Sans',sans-serif;font-weight:400;"><Fragment set:html={t('prec-ret-per')} /></span></div></div>
<div class="piloto-card"><div class="piloto-name"><Fragment set:html={t('prec-ret-estandar-name')} /></div><div class="piloto-hours"><Fragment set:html={t('prec-ret-estandar-hours')} /></div><div class="piloto-price">{usdRango(OFERTA.piloto[1].usd, lang)}<span style="font-size:13px;color:var(--muted);font-family:'DM Sans',sans-serif;font-weight:400;"><Fragment set:html={t('prec-ret-per')} /></span></div></div>
<div class="piloto-card"><div class="piloto-name"><Fragment set:html={t('prec-ret-avanzado-name')} /></div><div class="piloto-hours"><Fragment set:html={t('prec-ret-avanzado-hours')} /></div><div class="piloto-price">{usdRango(OFERTA.piloto[2].usd, lang)}<span style="font-size:13px;color:var(--muted);font-family:'DM Sans',sans-serif;font-weight:400;"><Fragment set:html={t('prec-ret-per')} /></span></div></div>
</div><p class="radar-note" style="margin-top:20px; text-align:center;"><Fragment set:html={t('prec-ret-p')} /></p><div style="text-align:center; margin-top:16px;"><button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-outline"><Fragment set:html={t('prec-ret-btn')} /></button></div></div></section><div class="cta-band"><div class="container"><h2><Fragment set:html={t('prec-cta-title')} /></h2><p><Fragment set:html={t('prec-cta-sub')} /></p><div class="cta-buttons"><button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-primary"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg><span><Fragment set:html={t('prec-btn-calendar')} /></span></button><a href="https://wa.me/56988974898" target="_blank" class="btn btn-outline"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg><span><Fragment set:html={t('prec-btn-whatsapp')} /></span></a></div></div></div>
