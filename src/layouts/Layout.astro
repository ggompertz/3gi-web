<body>

<!-- Cookie consent banner -->
<div id="tgi-consent" class="tgi-consent" hidden>
  <!-- Sin data-i18n: la tabla de traducción vestigial de más abajo sobrescribía este texto en el navegador con la versión vieja (solo Google Analytics) -->
  <p class="tgi-consent-text">
    <span class="tgi-consent-long">{lang === 'en' ? 'We use analytics and advertising measurement cookies (Google Analytics, PostHog, LinkedIn) to understand how this site is used and measure our ads. If you reject, we only record, without cookies and without identifying you, your steps in the ERA Test and the campaign you came from.' : 'Usamos cookies de analítica y de medición publicitaria (Google Analytics, PostHog, LinkedIn) para entender cómo se usa este sitio y medir nuestros anuncios. Si rechazas, solo registramos, sin cookies ni identificarte, los pasos del Test ERA y la campaña de origen.'}</span>
    <span class="tgi-consent-short">{lang === 'en' ? <>We use analytics and advertising cookies (Google, PostHog, LinkedIn). <a href={`${p}/privacidad`}>Learn more</a></> : <>Usamos cookies de analítica y publicidad (Google, PostHog, LinkedIn). <a href={`${p}/privacidad`}>Más información</a></>}</span>
  </p>
  <div class="tgi-consent-actions">
    <button id="tgi-consent-reject" class="tgi-consent-btn tgi-consent-btn-reject" data-i18n="cookie-reject">{lang === 'en' ? 'Reject' : 'Rechazar'}</button>
    <button id="tgi-consent-accept" class="tgi-consent-btn tgi-consent-btn-accept" data-i18n="cookie-accept">{lang === 'en' ? 'Accept' : 'Aceptar'}</button>
  </div>
</div>
<script is:inline>
  (function() {
    try {
      var tgiConsent = localStorage.getItem('tgi_consent');
      if (tgiConsent) {
        JSON.parse(tgiConsent);
        return;
      }
    } catch (e) {}
    var banner = document.getElementById('tgi-consent');
    if (!banner) return;
    banner.hidden = false;

    // Minimiza el banner (desliza fuera de pantalla, sin ocultarlo del DOM ni
    // tocar el estado de consentimiento) apenas el usuario empieza a scrollear,
    // y lo vuelve a mostrar si vuelve al tope de la página. Evita que tape
    // contenido interactivo más abajo (ver comentario CSS de .tgi-consent).
    var scrollListenerActive = true;
    function onScroll() {
      if (!scrollListenerActive) return;
      banner.classList.toggle('tgi-consent-minimized', window.scrollY > 24);
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    document.getElementById('tgi-consent-accept').addEventListener('click', function() {
      localStorage.setItem('tgi_consent', JSON.stringify({status: 'accepted', ts: new Date().toISOString(), v: 1}));
      banner.hidden = true;
      scrollListenerActive = false;
      window.removeEventListener('scroll', onScroll);
      if (window.__loadGTM) window.__loadGTM();
      if (window.__loadPostHog) window.__loadPostHog();
      if (window.__loadLinkedIn) window.__loadLinkedIn();
      if (window.__funnelTrack) window.__funnelTrack('consent_accepted');
    });
    document.getElementById('tgi-consent-reject').addEventListener('click', function() {
      localStorage.setItem('tgi_consent', JSON.stringify({status: 'rejected', ts: new Date().toISOString(), v: 1}));
      banner.hidden = true;
      scrollListenerActive = false;
      window.removeEventListener('scroll', onScroll);
      if (window.__funnelTrack) window.__funnelTrack('consent_rejected');
    });
  })();
</script>

