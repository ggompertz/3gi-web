    .tgi-consent {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999;
    background: #06060D; border-top: 1px solid #1F2937;
    padding: 16px 24px; display: flex; flex-wrap: wrap; gap: 16px;
    align-items: center; justify-content: space-between;
  }
  .tgi-consent-text { font-size: 13px; color: #9CA3AF; margin: 0; max-width: 640px; }
  .tgi-consent-actions { display: flex; gap: 8px; flex-shrink: 0; }
  .tgi-consent-btn {
    padding: 8px 18px; border-radius: 4px; font-size: 13px; font-weight: 600;
    cursor: pointer; border: 1px solid #374151;
  }
  .tgi-consent-btn-reject { background: transparent; color: #9CA3AF; }
  .tgi-consent-btn-accept { background: #00E891; color: #06060D; border-color: #00E891; }
  /* El atributo hidden debe ganar sobre display:flex (estilo de autor vs UA):
     sin esto, aceptar/rechazar no cierra el banner. */
  .tgi-consent[hidden] { display: none !important; }
  /* El banner es position:fixed sobre el borde inferior del viewport (z-index 9999),
     así que CUALQUIER contenido que quede en esa franja durante el scroll recibe el
     tap en vez del elemento real de abajo — no importa cuánto padding tenga la
     página, porque el problema es geométrico (el elemento pasa por esa franja
     mientras se scrollea, esté donde esté en el documento). Bug real encontrado en
     /test-era/: 0 clics reales en "Empezar Test ERA" en 5+ semanas porque el botón
     cae justo en esa franja durante el scroll mínimo necesario para verlo.
     Fix: el banner se "minimiza" (se desliza fuera de pantalla) en cuanto el
     usuario empieza a scrollear, y vuelve a aparecer si scrollea de nuevo al tope
     — no otorga ni asume consentimiento, solo dejar de bloquear el contenido.
     Sigue siendo accesible vía "Preferencias de cookies" en el footer en cualquier
     momento (window.__tgiConsentReset). */
  .tgi-consent { transition: transform 0.25s ease; }
  .tgi-consent.tgi-consent-minimized { transform: translateY(120%); }
  /* Móvil: banner compacto (texto corto + botones en una fila, ~80 px en vez de ~124). El banner
     alto tapaba la mitad inferior del botón "Empezar Test ERA" al cargar en 390x844 (iPhone 12 a
     14), justo en el tráfico de la campaña de LinkedIn. El texto largo queda en escritorio y la
     información completa en /privacidad (enlace en el texto corto). */
  .tgi-consent-short { display: none; }
  @media (max-width: 640px) {
    .tgi-consent { padding: 8px 12px; gap: 6px; }
    .tgi-consent-long { display: none; }
    .tgi-consent-short { display: inline; }
    .tgi-consent-short a { color: #00E891; text-decoration: underline; }
    .tgi-consent-text { font-size: 12px; line-height: 1.35; }
    .tgi-consent-actions { width: 100%; }
    .tgi-consent-btn { flex: 1; padding: 8px 12px; }
  }
</style>
