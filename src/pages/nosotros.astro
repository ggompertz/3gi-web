---
import Layout from '../layouts/Layout.astro';
import NosotrosPage from '../components/pages/NosotrosPage.astro';
import { nosotros } from '../i18n/nosotros.mjs';
const lang = 'es';
const { title, description } = nosotros[lang].meta;
---
<Layout title={title} description={description} lang={lang}>
  <NosotrosPage lang={lang} />
</Layout>
