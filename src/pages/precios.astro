---
import Layout from '../layouts/Layout.astro';
---

<style>
.page-hero{padding:140px 0 72px;background:var(--night-2);border-bottom:1px solid var(--border)}.page-tag{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin-bottom:16px}.page-title{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(32px,5vw,56px);letter-spacing:-.03em;line-height:1.05;margin-bottom:16px}.page-sub{font-size:18px;font-weight:300;color:#eef1f699;max-width:600px;line-height:1.65}.inv-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px}.inv-card{border-radius:14px;padding:36px 36px 40px;border:1px solid var(--border);position:relative;overflow:hidden;background:var(--night-2)}.inv-card.featured{border-color:rgba(0,232,145,0.35);background:rgba(0,232,145,0.05)}.inv-card.featured:before{content:attr(data-popular);position:absolute;top:0;right:28px;background:var(--green);color:var(--night);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 14px;border-radius:0 0 8px 8px}.inv-name{font-family:Syne,sans-serif;font-weight:800;font-size:22px;letter-spacing:-.02em;margin-bottom:8px}.inv-desc{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:24px}.inv-price{font-family:Syne,sans-serif;font-weight:800;font-size:40px;letter-spacing:-.03em;color:var(--green);margin-bottom:6px;line-height:1}.inv-price-sub{font-size:13px;color:var(--muted);margin-bottom:28px}.inv-includes{list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:32px}.inv-includes li{font-size:14px;color:#eef1f6bf;display:flex;align-items:flex-start;gap:10px}.inv-includes li:before{content:"\2713";color:var(--green);font-weight:700;font-size:13px;margin-top:2px;flex-shrink:0}.inv-note{padding:20px 24px;background:#f59e0b12;border:1px solid rgba(0,232,145,.15);border-radius:10px;margin-top:8px}.inv-note p{font-size:14px;color:#eef1f6b3;line-height:1.65}.inv-note strong{color:var(--green)}#data-foundation{background:var(--night-2)}.df-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}.df-card{background:var(--night-3);border:1px solid var(--border);border-radius:12px;padding:28px 24px}.df-level{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--green);margin-bottom:10px}.df-name{font-family:Syne,sans-serif;font-weight:800;font-size:18px;margin-bottom:8px}.df-price{font-family:Syne,sans-serif;font-weight:800;font-size:22px;color:var(--green);margin-bottom:12px}.df-desc{font-size:13px;color:var(--muted);line-height:1.65}.retainer-card{border:1px solid rgba(0,232,145,.2);border-radius:14px;padding:36px 40px;background:rgba(0,232,145,0.05);display:flex;align-items:center;gap:40px;flex-wrap:wrap;margin-top:20px}.retainer-price{font-family:Syne,sans-serif;font-weight:800;font-size:36px;color:var(--green);white-space:nowrap}.retainer-price span{font-size:16px;color:var(--muted);font-family:DM Sans,sans-serif;font-weight:400}.retainer-desc{flex:1}.retainer-desc h3{font-family:Syne,sans-serif;font-weight:800;font-size:20px;margin-bottom:8px}.retainer-desc p{font-size:14px;color:var(--muted);line-height:1.65}.cta-band{background:var(--night-2);border-top:1px solid var(--border);padding:72px 0;text-align:center}.cta-band h2{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(24px,4vw,40px);letter-spacing:-.03em;margin-bottom:12px}.cta-band p{font-size:16px;color:var(--muted);margin-bottom:32px}.cta-buttons{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}
/* Radar Express — tabla segmentada por tamaño */
.radar-table{width:100%;border-collapse:collapse;margin-top:4px;margin-bottom:20px;font-size:13px}.radar-table th{text-align:left;font-family:Syne,sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:0 10px 8px 0;border-bottom:1px solid var(--border)}.radar-table td{padding:10px 10px 10px 0;border-bottom:1px solid var(--border);color:#eef1f6bf}.radar-table tr:last-child td{border-bottom:none}.radar-table .seg-name{font-weight:700;color:var(--offwh)}.radar-table .seg-price{color:var(--green);font-weight:700;white-space:nowrap}.radar-note{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:24px}
/* Plan de Vuelo */
.pdv-why{margin-top:16px;padding-top:16px;border-top:1px dashed var(--border)}.pdv-why-label{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}.pdv-why p{font-size:13px;color:var(--muted);line-height:1.6;margin:0 0 10px}.pdv-why p:last-child{margin-bottom:0}
/* Data Foundation — certificado DRC-DF */
.cert-callout{background:rgba(0,232,145,.06);border:1px solid rgba(0,232,145,.2);border-radius:12px;padding:24px 28px;margin-top:24px}.cert-callout-title{font-family:Syne,sans-serif;font-weight:800;font-size:15px;color:var(--green);margin-bottom:8px;display:flex;align-items:center;gap:8px}.cert-callout p{font-size:13.5px;color:#eef1f6bf;line-height:1.65;margin:0}.cert-callout code{font-size:12px;background:var(--night-3);padding:2px 6px;border-radius:4px}
/* Piloto Automático — 3 niveles */
.piloto-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}.piloto-card{background:var(--night-3);border:1px solid var(--border);border-radius:12px;padding:28px 24px}.piloto-name{font-family:Syne,sans-serif;font-weight:800;font-size:18px;margin-bottom:6px}.piloto-hours{font-size:12px;color:var(--muted);margin-bottom:14px}.piloto-price{font-family:Syne,sans-serif;font-weight:800;font-size:22px;color:var(--green)}
@media(max-width:900px){.inv-grid,.df-grid,.piloto-grid{grid-template-columns:1fr}.retainer-card{flex-direction:column;gap:20px}}@media(max-width:480px){.inv-price{font-size:clamp(22px,6vw,32px)}.retainer-price{font-size:clamp(18px,5vw,28px);white-space:normal}}
</style>

<Layout title="El diagnóstico cuesta menos que un error de implementación · 3G Intelligence" description="Test ERA gratuito de IA para PyMEs. Sin riesgo, sin compromiso. Precios claros desde el primer día.">
<div class="page-hero"><div class="container"><div class="page-tag" data-i18n="prec-tag">Inversión</div><h1 class="page-title" data-i18n="prec-title">El diagnóstico cuesta menos<br>que un error de implementación.</h1><p class="page-sub" data-i18n="prec-sub">Sin el Test ERA, las empresas arriesgan USD 30.000–100.000 en implementaciones incorrectas. El costo de saber es una fracción de eso.</p></div></div>

<div style="background:rgba(0,232,145,0.06); border-bottom:1px solid rgba(0,232,145,0.15); padding:14px 0;">
  <div class="container" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <p style="font-size:14px; color:rgba(238,241,246,0.85); margin:0;">
      💡 <strong style="color:#00E891;">¿Aún no hiciste el Test ERA?</strong> Es gratuito, tarda 5 minutos y te dice exactamente en qué ERA está tu empresa — el mejor punto de partida antes de evaluar precios.
    </p>
    <a href="/test-era" class="btn btn-primary" style="white-space:nowrap; padding:10px 20px; font-size:13px;">Hacer el Test ERA gratis →</a>
  </div>
</div>

<section><div class="container"><div class="section-tag" data-i18n="prec-diag-tag">Radar</div><h2 class="section-title" data-i18n="prec-diag-title">Elige tu punto de entrada</h2><p class="section-sub" data-i18n="prec-diag-sub">Ambas opciones incluyen entregables concretos — informes ejecutivos que son tuyos sin importar qué decidas hacer después. Ninguna incluye scoring, ROI ni PRD — eso vive en Plan de Vuelo.</p><div class="inv-grid">
<!-- RADAR EXPRESS -->
<div class="inv-card">
  <div class="inv-name" data-i18n="prec-scan-name">Radar Express</div>
  <div class="inv-desc" data-i18n="prec-scan-desc">Una conversación: 1 sesión con la dirección. Rápido, pero es la versión de la empresa que tiene el dueño o gerente.</div>
  <table class="radar-table">
    <thead><tr><th data-i18n="prec-scan-th-seg">Segmento</th><th data-i18n="prec-scan-th-info">Empleados / Ventas anuales</th><th data-i18n="prec-scan-th-price">Precio</th></tr></thead>
    <tbody>
      <tr><td class="seg-name" data-i18n="prec-scan-seg1-name">Micro</td><td data-i18n="prec-scan-seg1-info">1–9 · hasta 2.400 UF</td><td class="seg-price">USD 1.200–1.800</td></tr>
      <tr><td class="seg-name" data-i18n="prec-scan-seg2-name">Pequeña</td><td data-i18n="prec-scan-seg2-info">10–49 · 2.400–25.000 UF</td><td class="seg-price">USD 1.800–2.500</td></tr>
      <tr><td class="seg-name" data-i18n="prec-scan-seg3-name">Mediana</td><td data-i18n="prec-scan-seg3-info">50–199 · 25.000–100.000 UF</td><td class="seg-price">USD 2.500–3.500</td></tr>
      <tr><td class="seg-name" data-i18n="prec-scan-seg4-name">Grande</td><td data-i18n="prec-scan-seg4-info">200+ · sobre 100.000 UF</td><td class="seg-price" data-i18n="prec-scan-seg4-price">A cotizar</td></tr>
    </tbody>
  </table>
  <p class="radar-note" data-i18n="prec-scan-note">Se aplica el segmento más alto entre empleados y ventas anuales. Sesión de ~45 min para Micro/Pequeña, 2 horas para Mediana en adelante.</p>
  <ul class="inv-includes"><li data-i18n="prec-scan-li2">Score de Madurez IA en 5 dimensiones</li><li data-i18n="prec-scan-li3">Clasificación de ERA (1, 2 o 3)</li><li data-i18n="prec-scan-li4">3–7 oportunidades preliminares</li><li data-i18n="prec-scan-li5">Informe ejecutivo para el directorio</li><li data-i18n="prec-scan-li6">Decisión: ¿avanzar directo o construir Data Foundation?</li></ul>
  <button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-outline" style="width:100%; justify-content:center;"><span data-i18n="prec-scan-btn">Agendar Radar Express</span></button>
</div>
<!-- RADAR 360 -->
<div class="inv-card featured" id="radar-360-card" data-popular="Más popular">
  <div class="inv-name" data-i18n="prec-full-name">Radar 360</div>
  <div class="inv-desc" data-i18n="prec-full-desc">Una vuelta completa por tu empresa: entrevistas con 4–6 áreas (operaciones, ventas, finanzas, RRHH...), no solo la mirada de arriba.</div>
  <div class="inv-price">USD 6.000</div>
  <div class="inv-price-sub" data-i18n="prec-full-priceSub">pago único · plano, todos los tamaños</div>
  <ul class="inv-includes"><li data-i18n="prec-full-li1">Todo lo incluido en Radar Express</li><li data-i18n="prec-full-li2">Entrevistas con 4–6 áreas de la empresa</li><li data-i18n="prec-full-li3">Mapeo de procesos más profundo</li><li data-i18n="prec-full-li4">Lista de oportunidades validada desde varios ángulos</li><li data-i18n="prec-full-li5"><strong>Quick Wins:</strong> 2–3 acciones de ≤4 semanas, ejecutables esta semana</li></ul>
  <button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-primary" style="width:100%; justify-content:center;"><span data-i18n="prec-full-btn">Agendar Radar 360</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></button>
</div>
</div><div class="inv-note" style="max-width:760px; margin:0 auto;"><p data-i18n="prec-note"><strong>Nota sobre el valor del Test ERA:</strong> Si el primer proyecto de implementación identificado tiene un ROI de USD 40.000 anuales, el costo del Test ERA representa menos del 20% del retorno del primer año. Además, el costo del Test ERA se descuenta de Plan de Vuelo si se contrata dentro de los <strong>90 días</strong> siguientes a la entrega del informe.</p></div></div></section>

<section><div class="container"><div class="section-tag" data-i18n="prec-pdv-tag">Ejecución</div><h2 class="section-title" data-i18n="prec-pdv-title">Plan de Vuelo</h2><p class="section-sub" data-i18n="prec-pdv-sub">Aquí — y solo aquí — se cuantifica, se diseña y se construye. Nada de esto se vende ya en Radar.</p>
<div class="inv-card featured" data-popular="Cotización tras tu Radar" style="max-width:640px; margin:0 auto;">
  <div class="inv-desc" data-i18n="prec-pdv-desc" style="margin-bottom:20px;">El tramo que ejecuta el roadmap completo: scoring cuantificado con ROI a 12 meses, análisis profundo de procesos, PRD técnico completo y la implementación acompañada.</div>
  <ul class="inv-includes"><li data-i18n="prec-pdv-li1">Scoring + Report cuantificado de cada oportunidad, con ROI a 12 meses</li><li data-i18n="prec-pdv-li2">Análisis profundo de procesos</li><li data-i18n="prec-pdv-li3">PRD técnico completo — todas las oportunidades, no solo las 3 top</li><li data-i18n="prec-pdv-li4">Implementación acompañada</li></ul>
  <div class="inv-price">Desde USD 6.700</div>
  <div class="inv-price-sub" data-i18n="prec-pdv-priceSub">piso real, no el precio final</div>
  <div class="pdv-why">
    <div class="pdv-why-label" data-i18n="prec-pdv-why-label">¿Por qué no hay un precio fijo?</div>
    <p data-i18n="prec-pdv-why-1">Porque a diferencia de Radar, acá el precio depende de 3 cosas que recién se saben al terminar tu Radar: cuántas oportunidades decides perseguir, qué tan compleja es la solución técnica, y el tamaño de tu empresa. La cotización final llega junto con el resultado de tu Radar, no antes.</p>
    <p data-i18n="prec-pdv-why-2">La implementación se cobra aparte, como 10–20% del ROI que ya demostramos que vas a tener (solo si ese ROI validado supera USD 30.000) — no pagas por construir algo cuyo retorno no está probado todavía.</p>
  </div>
  <button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-primary" style="width:100%; justify-content:center; margin-top:24px;"><span data-i18n="prec-pdv-btn">Conversemos tu Plan de Vuelo</span></button>
</div>
</div></section>

<section id="data-foundation"><div class="container"><div class="section-tag" data-i18n="prec-df-tag">Opcional · Antes de Plan de Vuelo</div><h2 class="section-title" data-i18n="prec-df-title">Data Foundation</h2><p class="section-sub" data-i18n="prec-df-sub">No lo eliges tú — lo determina tu Radar. Si tus datos ya califican, certificamos directo. Si hay brechas, proponemos un proyecto previo según el nivel detectado.</p><div class="df-grid"><div class="df-card"><div class="df-level">Nivel N1</div><div class="df-name" data-i18n="prec-df1-name">Ordenamiento Básico</div><div class="df-price">USD 800–2.500</div><div class="df-desc" data-i18n="prec-df1-desc">Problemas básicos de organización de datos. Estructuración de archivos, limpieza de registros, estandarización de formatos.</div></div><div class="df-card"><div class="df-level">Nivel N2</div><div class="df-name" data-i18n="prec-df2-name">Centralización y Automatización</div><div class="df-price">USD 2.500–6.000</div><div class="df-desc" data-i18n="prec-df2-desc">Integración de fuentes dispersas y mejora de calidad de datos. Consolidación de sistemas, pipelines básicos, dashboard integrado.</div></div><div class="df-card"><div class="df-level">Nivel N3</div><div class="df-name" data-i18n="prec-df3-name">Data Warehouse Empresarial</div><div class="df-price">USD 6.000–15.000</div><div class="df-desc" data-i18n="prec-df3-desc">Arquitectura de datos compleja. Data warehouse, data lake, integración de múltiples sistemas críticos de negocio.</div></div></div>
<div class="cert-callout"><div class="cert-callout-title">🏅 <span data-i18n="prec-cert-title">Data Foundation Certificate</span></div><p data-i18n="prec-cert-desc">Al completar cualquier nivel — o si tus datos ya calificaban sin necesitar proyecto — emitimos un certificado real (código <code>DRC-DF</code>) que acredita que tu empresa está lista para proyectos de IA. Válido 12 meses, sujeto a reevaluación anual. Un entregable tangible que puedes mostrar a tu directorio o inversionistas.</p></div>
</div></section>

<section><div class="container"><div class="section-tag" data-i18n="prec-ret-tag">Continuo</div><h2 class="section-title" data-i18n="prec-ret-title">Piloto Automático</h2><p class="section-sub" data-i18n="prec-ret-sub">Una vez en el nuevo rumbo, esto lo mantiene: soporte y evolución continua de las soluciones ya implementadas.</p><div class="piloto-grid">
<div class="piloto-card"><div class="piloto-name" data-i18n="prec-ret-basico-name">Básico</div><div class="piloto-hours" data-i18n="prec-ret-basico-hours">5–10 horas/mes</div><div class="piloto-price">USD 1.500–2.500<span style="font-size:13px;color:var(--muted);font-family:'DM Sans',sans-serif;font-weight:400;" data-i18n="prec-ret-per">/mes</span></div></div>
<div class="piloto-card"><div class="piloto-name" data-i18n="prec-ret-estandar-name">Estándar</div><div class="piloto-hours" data-i18n="prec-ret-estandar-hours">10–20 horas/mes</div><div class="piloto-price">USD 2.500–4.500<span style="font-size:13px;color:var(--muted);font-family:'DM Sans',sans-serif;font-weight:400;" data-i18n="prec-ret-per">/mes</span></div></div>
<div class="piloto-card"><div class="piloto-name" data-i18n="prec-ret-avanzado-name">Avanzado</div><div class="piloto-hours" data-i18n="prec-ret-avanzado-hours">20–40 horas/mes</div><div class="piloto-price">USD 4.500–8.000<span style="font-size:13px;color:var(--muted);font-family:'DM Sans',sans-serif;font-weight:400;" data-i18n="prec-ret-per">/mes</span></div></div>
</div><p class="radar-note" style="margin-top:20px; text-align:center;" data-i18n="prec-ret-p">El nivel depende del alcance: número de soluciones activas, complejidad de integraciones y nivel de soporte requerido. Se cotiza a medida después de la implementación.</p><div style="text-align:center; margin-top:16px;"><button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-outline" data-i18n="prec-ret-btn">Consultar</button></div></div></section><div class="cta-band"><div class="container"><h2 data-i18n="prec-cta-title">¿Con cuál empezamos?</h2><p data-i18n="prec-cta-sub">Agenda una llamada de 30 minutos y te recomendamos la opción correcta para tu empresa.</p><div class="cta-buttons"><button data-cal-link="3g-intelligence/30min" data-cal-config='{"layout":"month_view"}' class="btn btn-primary"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg><span data-i18n="prec-btn-calendar">Agendar llamada gratuita</span></button><a href="https://wa.me/56988974898" target="_blank" class="btn btn-outline"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg><span data-i18n="prec-btn-whatsapp">WhatsApp</span></a></div></div></div>

