let _langPrec = (window.location.pathname.startsWith('/en/') || window.location.pathname === '/en') ? 'en' : 'es';
function applyLangPrec() {
  const radar360Card = document.getElementById('radar-360-card');
  if (radar360Card) {
    radar360Card.setAttribute('data-popular', _langPrec === 'en' ? 'Most popular' : 'Más popular');
  }
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const v = (T_precios[_langPrec] || T_precios['es'])[el.getAttribute('data-i18n')];
    if (v) el.innerHTML = v;
  });
}
document.addEventListener('DOMContentLoaded', () => { _langPrec = (window.location.pathname.startsWith('/en/') || window.location.pathname === '/en') ? 'en' : 'es'; applyLangPrec(); });
window.addEventListener('langchange', e => { _langPrec = e.detail; applyLangPrec(); });
