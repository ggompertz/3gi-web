---
import Layout from '../layouts/Layout.astro';
import MetodologiaPage from '../components/pages/MetodologiaPage.astro';
import { metodologia } from '../i18n/metodologia.mjs';
const lang = 'es';
const { title, description } = metodologia[lang].meta;
---
