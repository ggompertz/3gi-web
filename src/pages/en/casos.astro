---
import Layout from '../../layouts/Layout.astro';
---

<style>
*,*:before,*:after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{background:#06060d;color:#eef1f6;font-family:DM Sans,sans-serif;font-weight:400;line-height:1.6;-webkit-font-smoothing:antialiased}a{text-decoration:none;color:inherit}:root{--green: #00E891;--night: #06060D;--night-2: #0D0D1A;--night-3: #141422;--offwh: #EEF1F6;--muted: rgba(238,241,246,.45);--amber: #F59E0B;--blue: #60a5fa;--border: rgba(255,255,255,.07);--max: 1160px}.container{max-width:var(--max);margin:0 auto;padding:0 24px}.logo{display:inline-flex;flex-direction:column;font-family:Syne,sans-serif;font-weight:800;line-height:1}.logo-name{font-size:22px;letter-spacing:-.03em}.logo-name span{color:var(--green)}.logo-sub{font-size:7.5px;letter-spacing:.2em;text-transform:uppercase;color:#eef1f64d;margin-top:4px}.btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:8px;border:none;font-family:DM Sans,sans-serif;font-weight:500;font-size:15px;cursor:pointer;transition:all .2s;white-space:nowrap}.btn-primary{background:linear-gradient(90deg,#2563EB,#00E891);color:var(--night)}.btn-primary:hover{background:linear-gradient(90deg,#1D4ED8,#00ffA0);transform:translateY(-1px)}.btn-outline{background:transparent;color:var(--offwh);border:1px solid rgba(238,241,246,.2)}.btn-outline:hover{border-color:var(--green);color:var(--green)}.btn-whatsapp{background:#25d366;color:#fff}.btn-whatsapp:hover{background:#20bc5a;transform:translateY(-1px)}nav{position:fixed;top:0;left:0;right:0;z-index:100;background:#06060de6;backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}.nav-inner{max-width:var(--max);margin:0 auto;padding:0 24px;height:68px;display:flex;align-items:center;justify-content:space-between}.nav-links{display:flex;align-items:center;gap:32px;list-style:none}.nav-links a{font-size:14px;color:var(--muted);transition:color .2s}.nav-links a:hover,.nav-links a.active{color:var(--offwh)}.nav-cta{display:flex;gap:10px;align-items:center}.page-hero{padding:140px 0 72px;background:var(--night-2);border-bottom:1px solid var(--border)}.page-tag{font-family:Syne,sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin-bottom:16px}.page-title{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(32px,5vw,56px);letter-spacing:-.03em;line-height:1.05;margin-bottom:16px}.page-sub{font-size:18px;font-weight:300;color:#eef1f699;max-width:600px;line-height:1.65}
.cases-nav{padding:32px 0;background:var(--night);border-bottom:1px solid var(--border);position:sticky;top:68px;z-index:50}.cases-nav-inner{display:flex;gap:12px;flex-wrap:wrap}.cases-nav-btn{font-size:13px;font-weight:500;padding:7px 16px;border-radius:20px;border:1px solid var(--border);color:var(--muted);background:transparent;cursor:pointer;transition:all .2s;font-family:DM Sans,sans-serif}.cases-nav-btn:hover{color:var(--offwh);border-color:rgba(238,241,246,.2)}.cases-nav-btn.active{background:rgba(0,232,145,.1);border-color:rgba(0,232,145,.3);color:var(--green)}
.case-section{padding:72px 0}.case-section:nth-child(even){background:var(--night-2)}.case-section:nth-child(odd){background:var(--night)}.case-wrapper{background:var(--night-3);border:1px solid var(--border);border-radius:16px;overflow:hidden;max-width:900px}.case-header{padding:32px 40px 28px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}.case-badge{font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--green);background:#f59e0b1a;border:1px solid rgba(0,232,145,.2);padding:5px 12px;border-radius:20px}.case-badge-composite{font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--blue);background:rgba(96,165,250,.1);border:1px solid rgba(96,165,250,.2);padding:5px 12px;border-radius:20px}.case-company{font-family:Syne,sans-serif;font-weight:800;font-size:22px;letter-spacing:-.02em}.case-meta{font-size:13px;color:var(--muted);margin-top:4px}.case-body{padding:40px}.case-situation{font-size:16px;font-weight:300;color:#eef1f6bf;line-height:1.75;margin-bottom:40px}.case-results{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:40px}.result-card{background:var(--night-2);border-radius:10px;padding:20px 16px;border:1px solid var(--border);text-align:center}.result-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-bottom:10px}.result-before{font-size:14px;color:#eef1f659;text-decoration:line-through;margin-bottom:4px}.result-after{font-family:Syne,sans-serif;font-weight:800;font-size:22px;color:var(--green);line-height:1}.result-unit{font-size:11px;color:var(--muted);margin-top:6px;line-height:1.4}.case-quote{padding:24px 28px;border-left:3px solid var(--amber);background:rgba(0,232,145,0.04);border-radius:0 8px 8px 0;margin-bottom:32px}.case-quote p{font-size:16px;font-style:italic;font-weight:300;color:#eef1f6cc;line-height:1.7;margin-bottom:12px}.case-quote cite{font-size:13px;color:var(--muted);font-style:normal}.case-context{margin-top:48px;padding-top:40px;border-top:1px solid var(--border)}.context-title{font-family:Syne,sans-serif;font-weight:800;font-size:20px;margin-bottom:16px}.context-p{font-size:15px;color:#eef1f6a6;line-height:1.8;margin-bottom:16px}.composite-note{margin-top:16px;padding:12px 16px;background:rgba(96,165,250,.06);border:1px solid rgba(96,165,250,.15);border-radius:8px;font-size:12px;color:rgba(238,241,246,.45);line-height:1.6}.cta-band{background:var(--night-2);border-top:1px solid var(--border);padding:72px 0;text-align:center}.cta-band h2{font-family:Syne,sans-serif;font-weight:800;font-size:clamp(24px,4vw,40px);letter-spacing:-.03em;margin-bottom:12px}.cta-band p{font-size:16px;color:var(--muted);margin-bottom:32px}.cta-buttons{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}footer{background:var(--night-2);border-top:1px solid var(--border);padding:40px 0}.footer-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px}.footer-links{display:flex;gap:24px;list-style:none;flex-wrap:wrap}.footer-links a{font-size:13px;color:var(--muted);transition:color .2s}.footer-links a:hover{color:var(--offwh)}.footer-copy{font-size:13px;color:var(--muted)}@media(max-width:900px){.nav-links{display:none}.case-results{grid-template-columns:repeat(2,1fr)}.cases-nav{top:68px}}@media(max-width:600px){.case-body,.case-header{padding:24px 20px}.cases-nav{position:relative;top:0}.result-after{font-size:16px;overflow-wrap:break-word;word-break:break-word}.result-before{font-size:11px;overflow-wrap:break-word}.result-label{font-size:10px}}
</style>

<Layout title="Real Cases · AI Results for SMBs · 3G Intelligence" description="Real AI implementation results for SMBs. Inspections, perishables logistics, agricultural export and distribution. Concrete data, confidential names." lang="en">

<div class="page-hero">
  <div class="container">
    <div class="page-tag" data-i18n="casos-tag">Success Stories</div>
    <h1 class="page-title" data-i18n="casos-title">Real results.<br>Concrete data.</h1>
    <p class="page-sub" data-i18n="casos-sub">We don't show promises. We show what happened — with real numbers, even if the names are confidential.</p>
  </div>
</div>

<div class="cases-nav">
  <div class="container">
    <div class="cases-nav-inner">
      <a href="#certificaciones" class="cases-nav-btn" data-i18n="nav-cert">Inspections & Certifications</a>
      <a href="#logistica" class="cases-nav-btn" data-i18n="nav-log">Perishables Logistics</a>
      <a href="#agro" class="cases-nav-btn" data-i18n="nav-agro">Agricultural Export</a>
      <a href="#distribuidora" class="cases-nav-btn" data-i18n="nav-dist">Commercial Distributor</a>
    </div>
  </div>
</div>

<!-- CASO 1: CERTIFICACIONES -->
<section class="case-section" id="certificaciones">
  <div class="container">
    <div class="case-wrapper">
      <div class="case-header">
        <div>
          <div class="case-company" data-i18n="cert-company">Inspections & certifications · Vertical transportation · Chile</div>
          <div class="case-meta" data-i18n="cert-meta">ISO certified · 5–10 employees · 365 clients · 837 historical files</div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;">
            <span style="font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(0,232,145,0.08);border:1px solid rgba(0,232,145,0.2);color:rgba(0,232,145,0.8);padding:3px 10px;border-radius:20px;">Next.js</span>
            <span style="font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(0,232,145,0.08);border:1px solid rgba(0,232,145,0.2);color:rgba(0,232,145,0.8);padding:3px 10px;border-radius:20px;">TypeScript</span>
            <span style="font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(0,232,145,0.08);border:1px solid rgba(0,232,145,0.2);color:rgba(0,232,145,0.8);padding:3px 10px;border-radius:20px;">Supabase</span>
            <span style="font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(0,232,145,0.08);border:1px solid rgba(0,232,145,0.2);color:rgba(0,232,145,0.8);padding:3px 10px;border-radius:20px;">n8n</span>
            <span style="font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(0,232,145,0.08);border:1px solid rgba(0,232,145,0.2);color:rgba(0,232,145,0.8);padding:3px 10px;border-radius:20px;">WhatsApp API</span>
            <span style="font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(0,232,145,0.08);border:1px solid rgba(0,232,145,0.2);color:rgba(0,232,145,0.8);padding:3px 10px;border-radius:20px;">Gmail OAuth2</span>
            <span style="font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(0,232,145,0.08);border:1px solid rgba(0,232,145,0.2);color:rgba(0,232,145,0.8);padding:3px 10px;border-radius:20px;">Vercel CRON</span>
          </div>
        </div>
        <span class="case-badge" data-i18n="cert-badge">Real case · Anonymized data</span>
      </div>
      <div class="case-body">
        <p class="case-situation" data-i18n="cert-situation">For years, the company ran on a system nobody had designed: the manager and his right-hand person kept everything in their heads. Which jobs were in progress, which were waiting for approval, which were pending payment. They had operated for decades without serious problems — and had a valid reason for not wanting systems: they had previously worked with complex ERPs like SAP and Oracle, and held a bad memory of months of implementation, data nobody used, and a team entering information just to satisfy the software.<br><br>What changed everything was an internal review. Someone found completed jobs that had never been invoiced. It wasn't an isolated error — it was a silent leak that had been going on for months. The 3GI diagnosis quantified the problem: USD 250,000 in services delivered without billing. The projected ROI of solving it was 263% on total investment over 12 months.</p>
        <div class="case-results">
          <div class="result-card">
            <div class="result-label" data-i18n="cert-r1-label">per budget proposal</div>
            <div class="result-before">35 min</div>
            <div class="result-after">3 min</div>
            <div class="result-unit" data-i18n="cert-r1-unit">−91% administrative time</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="cert-r2-label">invoice requests</div>
            <div class="result-before" data-i18n="cert-r2-before">Manual</div>
            <div class="result-after" data-i18n="cert-r2-after">Automatic</div>
            <div class="result-unit" data-i18n="cert-r2-unit">Triggered when file is closed</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="cert-r3-label">stuck files</div>
            <div class="result-before" data-i18n="cert-r3-before">No visibility</div>
            <div class="result-after" data-i18n="cert-r3-after">Real alerts</div>
            <div class="result-unit" data-i18n="cert-r3-unit">Automatic notification to owner</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="cert-r4-label">lost billing</div>
            <div class="result-before">$0</div>
            <div class="result-after">$250k</div>
            <div class="result-unit" data-i18n="cert-r4-unit">Recovered in first quarter</div>
          </div>
        </div>
        <div class="case-quote">
          <p data-i18n="cert-quote">"Never again losing hours searching for information. Now we have complete visibility of our files, real-time indicators, and can scale the business without hiring more people. Next is automating field reports for our inspectors."</p>
          <cite data-i18n="cert-cite">— Manager, inspections and certifications company (name withheld for confidentiality)</cite>
        </div>
        <div class="case-context">
          <div class="context-title" data-i18n="cert-impl-title">The complete operating system that was built</div>
          <p class="context-p" data-i18n="cert-impl0" style="color:rgba(238,241,246,0.5);font-style:italic;">The key was not replicating an ERP. It was built around how the team already worked, not the other way around.</p>
          <p class="context-p" data-i18n="cert-impl1"><strong style="color:var(--offwh);">1. Real-time file dashboard.</strong> All 365 clients and 837 historical files have visible status: quoted, approved, under inspection, certifiable, billable, closed. The manager sees the full picture without asking anyone. The inspector updates from the field.</p>
          <p class="context-p" data-i18n="cert-impl2"><strong style="color:var(--offwh);">2. Automated quotes and billing via Gmail.</strong> When sending a proposal, the system generates and delivers the quote to the client by email automatically. When a file is marked as completed, it requests the invoice without manual intervention. The step that used to be forgotten can no longer be forgotten.</p>
          <p class="context-p" data-i18n="cert-impl3"><strong style="color:var(--offwh);">3. Operational WhatsApp Bot.</strong> Every stage change in a file triggers a WhatsApp notification to the relevant team member. The inspector knows when they're assigned to a job. The coordinator knows when an inspection is completed. No lost emails, no coordination calls.</p>
          <p class="context-p" data-i18n="cert-impl4"><strong style="color:var(--offwh);">4. Regulatory knowledge bot for field teams.</strong> Inspectors consult current technical regulations directly via WhatsApp and get answers in seconds. No searching through PDFs, no calling the office. The AI works where the work happens.</p>
          <p class="context-p" data-i18n="cert-impl5"><strong style="color:var(--offwh);">5. Automatic MINVU alerts.</strong> A CRON runs every morning at 8am and notifies clients with MINVU certificates nearing expiration. All certificates under automatic control — without anyone having to remember.</p>
          <div style="margin-top:24px;padding:16px 20px;background:rgba(0,232,145,0.04);border:1px solid rgba(0,232,145,0.12);border-radius:10px;">
            <p style="font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(0,232,145,0.6);margin-bottom:6px;">ROI proyectado a 12 meses</p>
            <p style="font-family:Syne,sans-serif;font-size:28px;font-weight:800;color:var(--green);">263%</p>
            <p style="font-size:13px;color:var(--muted);margin-top:4px;">Sobre la inversión total en diagnóstico e implementación</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CASO 2: LOGÍSTICA PERECEDEROS -->
<section class="case-section" id="logistica">
  <div class="container">
    <div class="case-wrapper">
      <div class="case-header">
        <div>
          <div class="case-company" data-i18n="log-company">Refrigerated transport company · Packing-to-port route</div>
          <div class="case-meta" data-i18n="log-meta">12 trucks · Maule and O'Higgins → San Antonio · Chile</div>
        </div>
        <span class="case-badge-composite" data-i18n="log-badge">Composite scenario · Based on real sector cases</span>
      </div>
      <div class="case-body">
        <p class="case-situation" data-i18n="log-situation">A company with 12 refrigerated trucks transporting fresh fruit from packhouses in Maule and O'Higgins to the port of San Antonio. The operations coordinator works nights during peak season because trucks depart at 2am. Every route deviation, unscheduled stop, or temperature alarm gets handled by phone — asleep or not. Last season: one truck stopped by mechanical failure with no client notification, a temperature alarm ignored for 40 minutes, and a $4.2 million CLP fine for missing the port's time window.<br><br>The exporter threatened to switch carriers. Hiring another night coordinator wasn't viable.</p>
        <div class="case-results">
          <div class="result-card">
            <div class="result-label" data-i18n="log-r1-label">Incident response time</div>
            <div class="result-before">40 min</div>
            <div class="result-after">&lt; 10 min</div>
            <div class="result-unit" data-i18n="log-r1-unit">Season average</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="log-r2-label">Time-window fines</div>
            <div class="result-before">3</div>
            <div class="result-after">0</div>
            <div class="result-unit" data-i18n="log-r2-unit">Following season</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="log-r3-label">Night operations</div>
            <div class="result-before" data-i18n="log-r3-before">Manual · Coordinator awake</div>
            <div class="result-after" data-i18n="log-r3-after">Autonomous agent</div>
            <div class="result-unit" data-i18n="log-r3-unit">Escalates only if no response</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="log-r4-label">Exporter contract</div>
            <div class="result-before" data-i18n="log-r4-before">At risk</div>
            <div class="result-after" data-i18n="log-r4-after">Renewed</div>
            <div class="result-unit" data-i18n="log-r4-unit">With increased volume</div>
          </div>
        </div>
        <div class="case-context">
          <div class="context-title" data-i18n="log-impl-title">What was implemented</div>
          <p class="context-p" data-i18n="log-impl1"><strong style="color:var(--offwh);">1. Incident response agent.</strong> Real-time fleet monitoring: detects unscheduled stops, route deviations, and temperature alarms. On any event, contacts the driver via WhatsApp with a defined protocol. If no response in 8 minutes, notifies the client and proposes a solution.</p>
          <p class="context-p" data-i18n="log-impl2"><strong style="color:var(--offwh);">2. Time-window control.</strong> The agent monitors estimated arrival times at the port in real time. If a delay is projected, it alerts the coordinator and client in advance — not after the problem occurs.</p>
          <p class="context-p" data-i18n="log-impl3"><strong style="color:var(--offwh);">3. Night operations dashboard.</strong> The coordinator checks the full fleet status on a simple panel before sleeping and upon waking. They're only called if the agent couldn't resolve something.</p>
          <div class="composite-note" data-i18n="log-composite-note">This is a composite scenario: it combines patterns observed across multiple perishables logistics operations in Chile. Numbers are representative of the sector, not a specific company.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CASO 3: EXPORTACIÓN AGRÍCOLA -->
<section class="case-section" id="agro">
  <div class="container">
    <div class="case-wrapper">
      <div class="case-header">
        <div>
          <div class="case-company" data-i18n="agro-company">Cherry exporter · Maule Valley</div>
          <div class="case-meta" data-i18n="agro-meta">80 hectares · Export to China · Chile</div>
        </div>
        <span class="case-badge-composite" data-i18n="agro-badge">Composite scenario · Based on real sector cases</span>
      </div>
      <div class="case-body">
        <p class="case-situation" data-i18n="agro-situation">A family farm of 80 hectares exporting cherries to China. The field manager makes irrigation decisions by experience and by how the soil looks. Phytosanitary records are kept in a notebook and WhatsApp. During peak season — October to January — there are 4 weeks where every decision defines export quality. The previous year, a full block arrived at the packhouse below minimum caliber due to undetected water stress. The packhouse rejected 18% of that block's fruit. The exporter deducted the price differential.<br><br>The owner calculated he would have paid anything to know 10 days earlier.</p>
        <div class="case-results">
          <div class="result-card">
            <div class="result-label" data-i18n="agro-r1-label">Rejection from water stress</div>
            <div class="result-before">18%</div>
            <div class="result-after">0%</div>
            <div class="result-unit" data-i18n="agro-r1-unit">Following season</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="agro-r2-label">Water consumption</div>
            <div class="result-before" data-i18n="agro-r2-before">No block-by-block control</div>
            <div class="result-after">−30%</div>
            <div class="result-unit" data-i18n="agro-r2-unit">Reduction over full season</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="agro-r3-label">Irrigation prescription</div>
            <div class="result-before" data-i18n="agro-r3-before">By experience</div>
            <div class="result-after" data-i18n="agro-r3-after">Data-driven · Daily</div>
            <div class="result-unit" data-i18n="agro-r3-unit">WhatsApp each morning by block</div>
          </div>
          <div class="result-card">
            <div class="result-label" data-i18n="agro-r4-label">Owner on-farm during season</div>
            <div class="result-before" data-i18n="agro-r4-before">24/7 on the farm</div>
            <div class="result-after" data-i18n="agro-r4-after">Only for decisions</div>
            <div class="result-unit" data-i18n="agro-r4-unit">Agent monitors. He directs.</div>
          </div>
        </div>
        <div class="case-context">
          <div class="context-title" data-i18n="agro-impl-title">What was implemented</div>
          <p class="context-p" data-i18n="agro-impl1"><strong style="color:var(--offwh);">1. Agronomic prescription agent.</strong> Connected to soil moisture sensors, satellite data, and weather forecasts. Each morning the field manager receives a WhatsApp irrigation instruction per block: sector, duration, and rationale. Not a dashboard to interpret — a concrete action.</p>
          <p class="context-p" data-i18n="agro-impl2"><strong style="color:var(--offwh);">2. Projected water deficit alert.</strong> The agent projects each block's water status 3 days out. If it detects imminent deficit, it alerts the field manager with enough lead time to act before the fruit is affected.</p>
          <p class="context-p" data-i18n="agro-impl3"><strong style="color:var(--offwh);">3. Automated phytosanitary records.</strong> Executed actions are logged automatically. The notebook and WhatsApp stop being the farm's only memory. The history is available for export audits.</p>
          <div class="composite-note" data-i18n="agro-composite-note">This is a composite scenario: it combines data from platforms like Instacrops and Kilimo (operating in Chile and LATAM) with Maule cherry export patterns. Water reduction (30%) and quality rejection numbers are aligned with sector studies under similar conditions.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CASO 4: DISTRIBUIDORA -->
<section class="case-section" id="distribuidora">
  <div class="container">
    <div class="case-wrapper">
